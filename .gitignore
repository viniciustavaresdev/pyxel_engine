# Ambiente virtual. Mora DENTRO da arvore do projeto, entao esta linha
# e a que mais importa aqui: sem ela o primeiro `git add .` levaria o
# Pyxel, o mypy e o resto junto.
venv/

# Bytecode
__pycache__/
*.py[cod]

# Instalacao editavel (`pip install -e .`)
*.egg-info/

# Caches de ferramenta. Os tres ja escrevem um .gitignore proprio la
# dentro, entao seriam ignorados de qualquer jeito -- estao aqui para
# que a regra nao dependa de a ferramenta continuar fazendo isso.
.pytest_cache/
.mypy_cache/
.ruff_cache/
